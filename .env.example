# LinkForge environment variables (SPEC.md §5.4) — copy to .env and fill in.

# MongoDB Atlas connection string. MONGODB_DB is optional (default: linkforge).
MONGODB_URI=
MONGODB_DB=linkforge

# bcrypt hash of the global gate password — never the plaintext password.
# Generate with:  node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
# NOTE: Next.js expands $VAR in .env files, so escape each $ in the hash as \$
# (e.g. '\$2b\$12\$...').
GATE_PASSWORD_HASH=

# Secret that signs session tokens (Phase 2). Generate:  openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob store token (https://vercel.com/docs/stores). When unset, files
# fall back to the local .local-blob/ directory (development only).
BLOB_READ_WRITE_TOKEN=

# Login rate limiting per IP (SPEC.md §5.1).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
